<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER"
      spacing="18"
      prefWidth="650"
      prefHeight="500"
      style="-fx-background-color: #F4F7F5; -fx-padding: 30;"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mycompany.antreanyuk.PrimaryController">

    <children>
        <Label text="ANTREYUK"
               style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #16834A;"/>

        <Label text="Sistem Antrean Digital Klinik"
               style="-fx-font-size: 16px; -fx-text-fill: #555555;"/>

        <Label text="POLI UMUM"
               style="-fx-font-size: 14px; -fx-font-weight: bold;"/>

        <VBox spacing="10"
              maxWidth="400"
              style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 12;">
            <children>
                <Label text="Pendaftaran Antrean"
                       style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

                <Label text="Masukkan nama lengkap Anda"/>

                <TextField fx:id="namaField"
                           promptText="Contoh: Budi Santoso"
                           prefHeight="38"/>

                <Button text="AMBIL NOMOR ANTREAN"
                        onAction="#ambilAntrean"
                        maxWidth="Infinity"
                        prefHeight="42"
                        style="-fx-background-color: #16834A; -fx-text-fill: white; -fx-font-weight: bold;"/>

                <Label text="Nomor Antrean Anda"/>

                <Label fx:id="nomorLabel"
                       text="-"
                       style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #16834A;"/>

                <Button text="CEK STATUS ANTREAN"
                        onAction="#cekStatus"
                        maxWidth="Infinity"
                        prefHeight="38"/>

                <Label fx:id="statusLabel"
                       text="Silakan ambil nomor antrean terlebih dahulu."
                       wrapText="true"/>

                <Label fx:id="informasiLabel"
                       text="Nomor dipanggil: - | Menunggu: 0"
                       wrapText="true"/>
            </children>
        </VBox>

        <Label text="AntreYuk - Klinik Poli Umum"/>
    </children>
</VBox>
